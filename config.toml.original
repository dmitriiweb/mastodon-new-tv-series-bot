# Under comment is the old version of config.toml
# send_to = ["mastodon", "telegram"]
# 
# target_genres = ["Fantasy", "Science-Fiction"]
# 
# [mastodon]
# mastodon_token = "mastodon token"
# mastodon_url = "https://your.mastodon.instance"
# mastodon_image_api_url = "https://your.mastodon.instance/api/v2/media"
# image_dir = "/path/to/images/dir"
# max_post_len = 500
# 
# [telegram]
# telegram_token = "telegram token"
# telegram_chat_id = "telegram chat id"
[settings]

[settings.telegram]
token = "telegram token"

[targets]

[[targets.mastodon]]
mastodon_token = "mastodon token 1"
mastodon_url = "https://your.mastodon.instance1"
mastodon_image_api_url = "https://your.mastodon.instance1/api/v2/media"
image_dir = "/path/to/images/dir1"
max_post_len = 500
target_genres = ["Fantasy", "Science-Fiction"]

[[targets.mastodon]]
mastodon_token = "mastodon token 2"
mastodon_url = "https://your.mastodon.instance2"
mastodon_image_api_url = "https://your.mastodon.instance2/api/v2/media"
image_dir = "/path/to/images/dir2"
max_post_len = 500
target_genres = ["Fantasy", "Science-Fiction"]

[[targets.telegram]]
telegram_chat_id = "telegram chat id 1"
target_genres = ["Fantasy", "Science-Fiction"]

[[targets.telegram]]
telegram_chat_id = "telegram chat id 2"
target_genres = ["Fantasy", "Science-Fiction"]
